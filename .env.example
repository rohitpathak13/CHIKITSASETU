# ==============================================================================
# MediCare AI - Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# Application Environment (development, testing, production)
ENV=development

# Cryptographic Secret Key (Used for Flask Sessions and JWT Signing)
SECRET_KEY=medicare-super-secret-key-change-in-production-2026

# Database Engine Configuration
# Set USE_SQLITE=true for local standalone SQLite development without Docker
USE_SQLITE=false

# PostgreSQL Database Credentials
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=medicare_ai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_2026

# Database Connection URL (Constructed automatically or override explicitly)
DATABASE_URL=postgresql+psycopg2://postgres:postgres_secure_2026@db:5432/medicare_ai

# Security & JWT Tokens
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Container Host Port Bindings (Maps HostPort -> ContainerPort)
# Adjust these if host ports 5000, 8000, or 5432 are in use by other services
FLASK_HOST_PORT=5050
FASTAPI_HOST_PORT=8080
POSTGRES_HOST_PORT=5433

# Internal Container Service Ports
FLASK_PORT=5000
FASTAPI_PORT=8000

# Concurrency & Worker Threads
GUNICORN_WORKERS=4
UVICORN_WORKERS=2
